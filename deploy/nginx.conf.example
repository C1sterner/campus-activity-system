server {
  # Configuration fragment only: replace hostname, certificate paths and root.
  listen 443 ssl;
  server_name campus.example.invalid;
  ssl_certificate /etc/nginx/certs/campus.crt;
  ssl_certificate_key /etc/nginx/certs/campus.key;
  client_max_body_size 22m;

  location / {
    root /srv/campus-activity/frontend;
    try_files $uri $uri/ /index.html;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
  }
}
